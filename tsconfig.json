{
    "compilerOptions": {
        "moduleResolution": "node",
        "target": "ESNext",
        "noImplicitAny": true,
        "declaration": true,
        "declarationDir": "types",
        "esModuleInterop": true,
        "strict": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
